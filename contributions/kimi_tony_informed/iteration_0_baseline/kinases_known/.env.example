# Copy to .env (gitignored) and fill in.
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.6

# Optional cost / size gates — defaults shown.
# LIMIT=10                   # process first N entities only (omit = all 527)
# MAX_COST_USD=5.0           # abort loop if cumulative cost exceeds this
# MAX_TURNS_PER_ENTITY=60    # safety net per-kinase
