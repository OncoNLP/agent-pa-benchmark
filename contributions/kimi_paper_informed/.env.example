# Kimi (Moonshot AI) API access — copy to .env and fill in.
# .env is gitignored (see repo root .gitignore). .env.example is NOT gitignored
# — keep it secret-free.

# Moonshot direct (current setup):
#   KIMI_BASE_URL=https://api.moonshot.ai/v1
#   KIMI_MODEL=kimi-k2.6        (or kimi-k2.5 for the cheaper variant)
# Pricing (per 1M tokens): kimi-k2.6 in $0.95 / out $4.00; kimi-k2.5 in $0.60 / out $3.00.

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.6
